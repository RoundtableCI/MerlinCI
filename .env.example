# Copy to .env and fill in. Never commit .env.
# Values below match deploy/docker-compose.yml for local development.
# merlin-api, merlin-worker and merlinctl read .env from the directory they are started in;
# a variable already set in the environment wins over this file.

# Configuration files (roles, policy, budget, models, profile)
MERLIN_CONFIG_DIR=configs

# Control plane. The token is required: anyone who has it can start work and approve
# actions. Use a long random secret of at least 24 characters.
MERLIN_API_ADDR=:8080
MERLIN_API_URL=http://localhost:8080
MERLIN_API_TOKEN=

# PostgreSQL (source of truth, pgvector).
# If another PostgreSQL already uses port 5432, set MERLIN_POSTGRES_PORT (for example 55432)
# before `docker compose up`, and use the same port in MERLIN_DATABASE_URL.
# MERLIN_POSTGRES_PORT=55432
MERLIN_DATABASE_URL=postgres://merlin:merlin@localhost:5432/merlin?sslmode=disable

# Redis (cache). Started by docker compose; nothing uses it yet.
MERLIN_REDIS_URL=redis://localhost:6379/0

# Durable workflows (Temporal)
MERLIN_TEMPORAL_ADDRESS=localhost:7233
MERLIN_TEMPORAL_NAMESPACE=default
MERLIN_TEMPORAL_TASK_QUEUE=merlin

# Object storage for artifact content (S3-compatible or R2).
# These credentials are the local-only ones in deploy/objectstore/s3.json.
MERLIN_S3_ENDPOINT=http://localhost:8333
MERLIN_S3_REGION=us-east-1
MERLIN_S3_BUCKET=merlin-artifacts
MERLIN_S3_ACCESS_KEY_ID=merlin
MERLIN_S3_SECRET_ACCESS_KEY=merlin-local-only

# Inference (OpenRouter). Read only by the integration layer, never by the model.
OPENROUTER_API_KEY=

# Web search (Brave Search). Read only by the integration layer, never by the model.
BRAVE_SEARCH_API_KEY=

# Product analytics (PostHog or equivalent). Not used yet.
POSTHOG_HOST=
POSTHOG_PROJECT_API_KEY=
