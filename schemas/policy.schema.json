{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MerlinCI policy document",
  "description": "Three tiers of autonomy: automatic, conditional, explicit authorization. Enforced by a policy engine, not by trusting an agent's instructions. Deck slide 11.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "merlinci/v1alpha1" },
    "kind": { "const": "Policy" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "rules"],
      "properties": {
        "default": {
          "description": "What happens to an action no rule matches. Always deny.",
          "const": "deny"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "tier"],
            "properties": {
              "action": {
                "description": "An action name such as research.search, or a prefix pattern such as research.*",
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*(\\.\\*)?$"
              },
              "tier": { "enum": ["automatic", "conditional", "explicit"] },
              "reason": { "type": "string" },
              "conditions": {
                "description": "Channel, content and frequency policy. Required for the conditional tier.",
                "type": "object",
                "additionalProperties": false,
                "required": ["channels", "requireApprovedContent", "maxPerDay"],
                "properties": {
                  "channels": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                  "requireApprovedContent": { "type": "boolean" },
                  "maxPerDay": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "if": { "properties": { "tier": { "const": "conditional" } } },
            "then": { "required": ["conditions"] },
            "else": { "not": { "required": ["conditions"] } }
          }
        }
      }
    }
  }
}
