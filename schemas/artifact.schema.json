{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MerlinCI artifact record",
  "description": "A validated output with provenance: the sources it traces to, the task and role that produced it, and its cost. Deck slides 3, 10 and 14.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "taskId", "role", "title", "content", "sources", "evaluations", "cost", "configDigest", "createdAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "taskId": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "campaignId": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "content": {
      "description": "The payload lives in object storage; the record holds its address and hash.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "blobKey", "sha256", "sizeBytes"],
      "properties": {
        "mediaType": { "type": "string", "minLength": 1 },
        "blobKey": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "sources": {
      "description": "Evidence the artifact traces to.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "retrievedAt"],
        "properties": {
          "url": { "type": "string", "pattern": "^https?://" },
          "title": { "type": "string" },
          "retrievedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "excerpt": { "type": "string" }
        }
      }
    },
    "derivedFrom": {
      "description": "Artifacts this one was built from, such as the brief behind an article.",
      "type": "array",
      "items": { "type": "string" }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evaluator", "verdict"],
        "properties": {
          "evaluator": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "verdict": { "enum": ["pass", "fail"] },
          "feedback": { "type": "string" }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "amount": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,6})?$" },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 }
      }
    },
    "configDigest": {
      "description": "Digest of the configuration the producing run used.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" }
  }
}
